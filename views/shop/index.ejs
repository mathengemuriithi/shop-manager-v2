<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.settings.shopName %> — Products & Services</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { box-sizing: border-box; }
    body { background: #060c18; font-family: 'Space Grotesk', sans-serif; }

    .grid-bg {
      background-image:
        linear-gradient(rgba(56,189,248,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56,189,248,0.03) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .nav-bar {
      background: rgba(6,12,24,0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(56,189,248,0.08);
    }
    .hero-glow {
      background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(14,165,233,0.12), transparent);
    }
    .search-bar {
      background: rgba(13,21,38,0.9);
      border: 1px solid rgba(56,189,248,0.15);
      color: #e2e8f0;
      transition: all 0.2s;
    }
    .search-bar:focus { outline: none; border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,0.1); }
    .search-bar::placeholder { color: #334155; }

    .cat-pill {
      background: rgba(13,21,38,0.8);
      border: 1px solid rgba(56,189,248,0.1);
      color: #64748b;
      transition: all 0.2s;
      cursor: pointer;
    }
    .cat-pill:hover, .cat-pill.active {
      background: rgba(56,189,248,0.1);
      border-color: rgba(56,189,248,0.4);
      color: #38bdf8;
    }

    .product-card {
      background: linear-gradient(145deg, #0d1526, #0a1020);
      border: 1px solid rgba(56,189,248,0.08);
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .product-card:hover {
      border-color: rgba(56,189,248,0.3);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(14,165,233,0.1);
    }
    .product-card:hover .card-arrow { opacity: 1; transform: translateX(0); }
    .card-arrow { opacity: 0; transform: translateX(-6px); transition: all 0.2s; }

    .price-tag {
      font-family: 'JetBrains Mono', monospace;
      background: linear-gradient(135deg, #0ea5e9, #0284c7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .badge { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; }
    .img-placeholder {
      background: linear-gradient(135deg, rgba(14,165,233,0.06), rgba(3,105,161,0.06));
      border-bottom: 1px solid rgba(56,189,248,0.06);
    }
    .section-divider {
      border-color: rgba(56,189,248,0.08);
    }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #060c18; }
    ::-webkit-scrollbar-thumb { background: #1e3a6e; border-radius: 3px; }

    .fade-in { animation: fadeIn 0.4s ease both; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
    .stagger-1 { animation-delay: 0.05s; }
    .stagger-2 { animation-delay: 0.10s; }
    .stagger-3 { animation-delay: 0.15s; }
  </style>
</head>
<body class="min-h-screen grid-bg text-slate-300">

  <!-- ── NAVBAR ─────────────────────────────────────────────────────────── -->
  <nav class="nav-bar sticky top-0 z-50 px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="/shop" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center text-lg"
             style="background:linear-gradient(135deg,#0ea5e9,#0369a1);box-shadow:0 4px 15px rgba(14,165,233,0.3);">
          🖥️
        </div>
        <div>
          <div class="font-bold text-white text-sm leading-tight"><%= data.settings.shopName %></div>
          <div class="text-xs text-slate-600">Computer Shop</div>
        </div>
      </a>
      <div class="flex items-center gap-4">
        <span class="hidden sm:flex items-center gap-1.5 text-xs text-slate-600">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block" style="box-shadow:0 0 6px #4ade80;"></span>
          Open for business
        </span>
      </div>
    </div>
  </nav>

  <!-- ── HERO ────────────────────────────────────────────────────────────── -->
  <div class="hero-glow pt-14 pb-10 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-block badge bg-blue-950 text-brand-400 px-3 py-1.5 rounded-full mb-5 border border-blue-900">
        🛍️ Browse Our Catalogue
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 leading-tight">
        Computers, Parts &<br/>
        <span style="background:linear-gradient(135deg,#38bdf8,#0284c7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
          Repair Services
        </span>
      </h1>
      <p class="text-slate-500 text-base max-w-lg mx-auto">
        Browse our full range of products and services. Contact us to place an order or book a repair.
      </p>
    </div>
  </div>

  <!-- ── SEARCH + FILTER ────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-6 pb-8">
    <form method="GET" action="/shop" class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-600 text-sm">🔍</span>
        <input
          type="text" name="search"
          value="<%= filters.search %>"
          placeholder="Search products and services…"
          class="search-bar w-full pl-10 pr-4 py-3 rounded-xl text-sm"
        />
      </div>
      <% if (filters.search || filters.category) { %>
        <a href="/shop" class="flex items-center justify-center px-5 py-3 rounded-xl text-sm text-slate-400 hover:text-white transition-colors"
           style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);">
          ✕ Clear
        </a>
      <% } %>
    </form>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-2 mt-4">
      <a href="/shop<%= filters.search ? '?search=' + filters.search : '' %>"
         class="cat-pill px-4 py-2 rounded-full text-sm font-medium <%= !filters.category ? 'active' : '' %>">
        All
      </a>
      <% data.categories.forEach(cat => { %>
        <a href="/shop?category=<%= cat.id %><%= filters.search ? '&search=' + filters.search : '' %>"
           class="cat-pill px-4 py-2 rounded-full text-sm font-medium <%= filters.category === cat.id ? 'active' : '' %>">
          <%= cat.icon %> <%= cat.name %>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- ── PRODUCTS GRID ──────────────────────────────────────────────────── -->
  <main class="max-w-7xl mx-auto px-6 pb-20">

    <% if (products.length === 0) { %>
      <div class="text-center py-20">
        <div class="text-5xl mb-4">🔍</div>
        <p class="text-slate-500 text-lg">No items found.</p>
        <a href="/shop" class="text-sm text-brand-400 mt-2 inline-block hover:text-brand-300">Clear search →</a>
      </div>

    <% } else { %>

      <%
        // Group products by category for display
        const grouped = {};
        const activeCats = filters.category
          ? data.categories.filter(c => c.id === filters.category)
          : data.categories;

        activeCats.forEach(cat => {
          const items = products.filter(p => p.categoryId === cat.id);
          if (items.length > 0) grouped[cat.id] = { cat, items };
        });

        // Items with no matching category
        const uncategorised = products.filter(p => !data.categories.find(c => c.id === p.categoryId));
      %>

      <% Object.values(grouped).forEach((group, gi) => { %>
        <!-- Category Section -->
        <div class="mb-12 fade-in" style="animation-delay: <%= gi * 0.08 %>s">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl"><%= group.cat.icon %></span>
            <h2 class="text-lg font-bold text-white"><%= group.cat.name %></h2>
            <div class="flex-1 border-t section-divider ml-2"></div>
            <span class="badge text-slate-600"><%= group.items.length %> item<%= group.items.length !== 1 ? 's' : '' %></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            <% group.items.forEach((item, i) => { %>
              <a href="/shop/item/<%= item.id %>" class="product-card rounded-2xl overflow-hidden block">

                <!-- Image -->
                <div class="h-44 img-placeholder flex items-center justify-center overflow-hidden">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" class="w-full h-full object-cover" />
                  <% } else { %>
                    <span class="text-5xl opacity-30"><%= item.type === 'service' ? '🔧' : '📦' %></span>
                  <% } %>
                </div>

                <!-- Details -->
                <div class="p-5">
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <h3 class="text-white font-semibold text-sm leading-snug flex-1"><%= item.name %></h3>
                    <span class="card-arrow text-brand-400 text-sm flex-shrink-0">→</span>
                  </div>

                  <% if (item.description) { %>
                    <p class="text-xs text-slate-600 mb-3 line-clamp-2 leading-relaxed"><%= item.description %></p>
                  <% } %>

                  <div class="flex items-end justify-between mt-auto pt-3 border-t" style="border-color:rgba(56,189,248,0.07);">
                    <div>
                      <div class="text-xs text-slate-600 mb-0.5">Price</div>
                      <div class="price-tag text-lg font-bold">
                        <%= data.settings.currencySymbol %> <%= item.price.toLocaleString() %>
                      </div>
                    </div>
                    <div class="text-right">
                      <% if (item.type === 'service') { %>
                        <span class="badge bg-purple-950 text-purple-400 px-2 py-1 rounded-lg">Service</span>
                      <% } else if (item.stock === 0) { %>
                        <span class="badge bg-red-950 text-red-400 px-2 py-1 rounded-lg">Out of Stock</span>
                      <% } else if (item.stock <= 3) { %>
                        <span class="badge bg-yellow-950 text-yellow-400 px-2 py-1 rounded-lg"><%= item.stock %> left</span>
                      <% } else { %>
                        <span class="badge bg-green-950 text-green-400 px-2 py-1 rounded-lg">In Stock</span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% }) %>

    <% } %>
  </main>

  <!-- ── FOOTER ─────────────────────────────────────────────────────────── -->
  <footer class="border-t section-divider py-8 px-6 text-center">
    <p class="text-slate-700 text-sm"><%= data.settings.shopName %> · All prices in <%= data.settings.currency %></p>
  </footer>

</body>
</html>
