<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= data.settings.shopName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Space Grotesk', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            brand: {
              50:  '#f0f9ff',
              100: '#e0f2fe',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              900: '#0c4a6e'
            },
            surface: {
              900: '#0a0f1a',
              800: '#0d1526',
              750: '#101d33',
              700: '#132240',
              600: '#1a2f52',
              500: '#1e3a6e',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { background: #0a0f1a; }
    .sidebar-link { transition: all 0.15s ease; }
    .sidebar-link:hover, .sidebar-link.active { background: rgba(56,189,248,0.12); color: #38bdf8; border-left: 3px solid #38bdf8; }
    .sidebar-link { border-left: 3px solid transparent; }
    .card { background: #0d1526; border: 1px solid rgba(56,189,248,0.1); }
    .card-glow { box-shadow: 0 0 30px rgba(56,189,248,0.05); }
    .btn-primary { background: linear-gradient(135deg, #0ea5e9, #0284c7); transition: all 0.2s; }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(14,165,233,0.4); }
    .btn-danger { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #f87171; transition: all 0.2s; }
    .btn-danger:hover { background: rgba(239,68,68,0.2); }
    .input-field { background: rgba(19,34,64,0.8); border: 1px solid rgba(56,189,248,0.15); color: #e2e8f0; transition: border-color 0.2s; }
    .input-field:focus { outline: none; border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,0.1); }
    .table-row:hover { background: rgba(56,189,248,0.04); }
    .badge { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; }
    .stat-card { background: linear-gradient(135deg, #0d1526, #132240); border: 1px solid rgba(56,189,248,0.12); }
    ::-webkit-scrollbar { width: 6px; } 
    ::-webkit-scrollbar-track { background: #0a0f1a; }
    ::-webkit-scrollbar-thumb { background: #1e3a6e; border-radius: 3px; }
  </style>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="h-full font-sans text-slate-300 flex overflow-hidden">

  <!-- ── SIDEBAR ─────────────────────────────────────────────────────────── -->
  <aside class="w-64 flex-shrink-0 flex flex-col" style="background:#080d18; border-right:1px solid rgba(56,189,248,0.08);">
    <!-- Logo -->
    <div class="px-6 py-5 border-b" style="border-color:rgba(56,189,248,0.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center text-lg" style="background:linear-gradient(135deg,#0ea5e9,#0369a1);">🖥️</div>
        <div>
          <div class="text-white font-bold text-sm leading-tight"><%= data.settings.shopName || 'TechPoint' %></div>
          <div class="text-xs text-slate-500">Management System</div>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
      <div class="text-xs text-slate-600 uppercase tracking-widest px-3 pb-2 pt-1">Main</div>
      <a href="/admin" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= title === 'Dashboard' ? 'active' : '' %>">
        <span class="text-base">📊</span> Dashboard
      </a>
      <a href="/admin/products" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= title === 'Products & Services' ? 'active' : '' %>">
        <span class="text-base">📦</span> Products & Services
      </a>
      <a href="/admin/products/add" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= title === 'Add Item' || title === 'Edit Item' ? 'active' : '' %>">
        <span class="text-base">➕</span> Add New Item
      </a>

      <div class="text-xs text-slate-600 uppercase tracking-widest px-3 pb-2 pt-4">Config</div>
      <a href="/admin/categories" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= title === 'Categories' ? 'active' : '' %>">
        <span class="text-base">🏷️</span> Categories
      </a>
      <a href="/admin/settings" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= title === 'Settings' ? 'active' : '' %>">
        <span class="text-base">⚙️</span> Settings
      </a>
    </nav>

    <!-- User Footer -->
    <div class="px-4 py-4 border-t" style="border-color:rgba(56,189,248,0.08);">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-brand-700 flex items-center justify-center text-xs font-bold text-brand-400">
            <%= username ? username[0].toUpperCase() : 'A' %>
          </div>
          <span class="text-sm text-slate-400"><%= username %></span>
        </div>
        <a href="/logout" class="text-xs text-slate-600 hover:text-red-400 transition-colors" title="Logout">🚪</a>
      </div>
    </div>
  </aside>

  <!-- ── MAIN CONTENT ────────────────────────────────────────────────────── -->
  <main class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="flex items-center justify-between px-8 py-4 flex-shrink-0" style="background:#080d18; border-bottom:1px solid rgba(56,189,248,0.08);">
      <h1 class="text-xl font-bold text-white"><%= title %></h1>
      <div class="flex items-center gap-4">
        <span class="text-xs text-slate-600 font-mono"><%= new Date().toLocaleDateString('en-KE', {weekday:'short', year:'numeric', month:'short', day:'numeric'}) %></span>
        <a href="/logout" class="text-sm text-slate-500 hover:text-red-400 transition-colors">Sign out →</a>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if (messages && (messages.success?.length || messages.error?.length)) { %>
    <div class="px-8 pt-4 flex-shrink-0">
      <% if (messages.success && messages.success.length) { %>
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm mb-2" style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);color:#86efac;">
          ✅ <%= messages.success[0] %>
        </div>
      <% } %>
      <% if (messages.error && messages.error.length) { %>
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.25);color:#fca5a5;">
          ⚠️ <%= messages.error[0] %>
        </div>
      <% } %>
    </div>
    <% } %>

    <!-- Page Content -->
    <div class="flex-1 overflow-y-auto px-8 py-6">
