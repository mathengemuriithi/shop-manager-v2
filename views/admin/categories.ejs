<%- include('../partials/layout-top', { title: 'Categories', data, username, messages }) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-4xl">

  <!-- Add Category Form -->
  <div class="card card-glow rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b" style="border-color:rgba(56,189,248,0.08);">
      <h2 class="font-semibold text-white text-sm">➕ New Category</h2>
    </div>
    <form method="POST" action="/admin/categories/add" class="px-6 py-5 space-y-4">
      <div>
        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wide mb-2">Category Name *</label>
        <input
          type="text" name="name" required
          placeholder="e.g. Gaming PCs"
          class="input-field w-full px-4 py-3 rounded-xl text-sm"
        />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wide mb-2">Icon Emoji</label>
        <input
          type="text" name="icon"
          placeholder="🖥️"
          maxlength="4"
          class="input-field w-full px-4 py-3 rounded-xl text-sm font-mono text-center text-xl"
        />
        <p class="text-xs text-slate-600 mt-1.5">Paste any emoji (optional)</p>
      </div>
      <button type="submit" class="btn-primary w-full py-3 rounded-xl text-white text-sm font-semibold">
        Create Category
      </button>
    </form>
  </div>

  <!-- Categories List -->
  <div class="lg:col-span-2 card card-glow rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b" style="border-color:rgba(56,189,248,0.08);">
      <h2 class="font-semibold text-white text-sm">All Categories</h2>
    </div>
    <div class="divide-y" style="border-color:rgba(56,189,248,0.06);">
      <% if (data.categories.length === 0) { %>
        <div class="px-6 py-10 text-center">
          <p class="text-slate-600 text-sm">No categories yet. Create one!</p>
        </div>
      <% } else { %>
        <% data.categories.forEach(cat => { %>
          <% const itemCount = data.products.filter(p => p.categoryId === cat.id).length; %>
          <div class="flex items-center justify-between px-6 py-4" style="border-bottom:1px solid rgba(56,189,248,0.05);">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl"
                   style="background:rgba(56,189,248,0.06);border:1px solid rgba(56,189,248,0.1);">
                <%= cat.icon %>
              </div>
              <div>
                <div class="text-white font-medium text-sm"><%= cat.name %></div>
                <div class="text-xs text-slate-600 mt-0.5 font-mono"><%= cat.id %></div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <span class="badge bg-slate-800 text-slate-400 px-3 py-1 rounded-lg">
                <%= itemCount %> item<%= itemCount !== 1 ? 's' : '' %>
              </span>
              <form method="POST" action="/admin/categories/delete/<%= cat.id %>"
                    onsubmit="return confirm('Delete category &quot;<%= cat.name %>&quot;? This only works if no items are assigned to it.')">
                <button type="submit" class="btn-danger px-3 py-1.5 rounded-lg text-xs">🗑️</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<div class="mt-4 max-w-4xl">
  <div class="px-5 py-4 rounded-xl text-xs text-slate-600" style="background:rgba(56,189,248,0.04);border:1px solid rgba(56,189,248,0.08);">
    ℹ️ A category can only be deleted when no products or services are assigned to it. Reassign items first.
  </div>
</div>

<%- include('../partials/layout-bottom') %>
