<%
  const siteUrl = (process.env.SITE_URL || '').replace(/\/$/, '');
  const fmt = (n) => 'KES ' + n.toLocaleString('en-US');

  const groups = [
    {
      id: 'printing',
      title: 'Printing and photocopying in Wang\'uru',
      intro: 'Our printing services in Wang\'uru cover CVs, school work, forms and business documents. Print, copy, laminate and bind at one counter, behind Lainisha Sacco.',
      items: [
        { name: 'Printing (B&W)', price: 10, unit: '/page' },
        { name: 'Photocopy', price: 10, unit: '/page' },
        { name: 'Lamination', price: 80, unit: '/page' },
        { name: 'Binding', price: 150, unit: '/doc' },
        { name: 'Scanning and CV writing', price: null }
      ]
    },
    {
      id: 'computer-repair',
      title: 'Laptop and computer repair in Mwea',
      intro: 'Laptop repair in Mwea from our Wang\'uru workshop. Bring in a slow, infected or broken computer and our technicians diagnose it, fix it and reinstall the software you need.',
      items: [
        { name: 'Computer Repair', price: 500, unit: '', from: true },
        { name: 'Software Install', price: 1500, unit: '' }
      ]
    },
    {
      id: 'government-services',
      title: 'Government online applications in Wang\'uru',
      intro: 'We handle government online applications for Wang\'uru and Mwea residents, so you skip the queue and the guesswork. Bring your ID and we file the application with you.',
      items: [
        { name: 'Good Conduct Application', price: 200, unit: '' },
        { name: 'DL Renewal', price: 250, unit: '' },
        { name: 'Passport Application', price: 1000, unit: '' },
        { name: 'KRA, HELB and KUCCPS services', price: null }
      ]
    },
    {
      id: 'internet-training',
      title: 'Internet access and training in Wang\'uru',
      intro: 'Browse in our cyber café in Wang\'uru, or learn the skills behind the screen with computer training and a monthly programming course.',
      items: [
        { name: 'Internet Access', price: 50, unit: '/hr' },
        { name: 'Computer Training', price: 4000, unit: '' },
        { name: 'Programming Training', price: 10000, unit: '/month' }
      ]
    }
  ];

  const offers = [];
  groups.forEach((g) => g.items.forEach((i) => {
    if (!i.price) return;
    const offer = { '@type': 'Offer', priceCurrency: 'KES', itemOffered: { '@type': 'Service', name: i.name } };
    if (i.from) offer.priceSpecification = { '@type': 'PriceSpecification', priceCurrency: 'KES', minPrice: i.price };
    else offer.price = String(i.price);
    offers.push(offer);
  }));

  const schema = {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'ComputerStore'],
    name: 'Expert Cyber Services',
    description: 'Cyber services in Wang\'uru, Mwea: printing, photocopying, laptop repair, software installation, internet access and government online applications.',
    telephone: '+254759697878',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Behind Lainisha Sacco',
      addressLocality: 'Wang\'uru',
      addressCountry: 'KE'
    },
    areaServed: [
      { '@type': 'Place', name: 'Wang\'uru' },
      { '@type': 'Place', name: 'Mwea' }
    ],
    openingHoursSpecification: [{
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '07:30',
      closes: '20:30'
    }],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Services and prices', itemListElement: offers }
  };
  if (siteUrl) { schema.url = siteUrl + '/'; schema['@id'] = siteUrl + '/#business'; }
  const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.settings.shopName %> | Cyber Services in Wang'uru</title>
  <meta name="description" content="Expert Cyber Services in Wang'uru, Mwea. Behind Lainisha Sacco. We offer printing, photocopying, laptop repair, software installation, internet access, and government online applications. Visit us or WhatsApp +254 759 697878." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <% if (siteUrl) { %><link rel="canonical" href="<%= siteUrl %>/" />
  <meta property="og:url" content="<%= siteUrl %>/" /><% } %>
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_KE" />
  <meta property="og:site_name" content="Expert Cyber Services" />
  <meta property="og:title" content="Cyber Services in Wang'uru, Mwea | Printing &amp; Computer Repair | Expert Cyber" />
  <meta property="og:description" content="Printing, photocopying, laptop repair, software installation, internet access and government online applications. Behind Lainisha Sacco, Wang'uru." />
  <meta name="theme-color" content="#060c18" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json"><%- schemaJson %></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 76px; }
    body {
      margin: 0; min-height: 100vh; color: #cbd5e1; background: #060c18;
      font-family: 'Space Grotesk', system-ui, sans-serif; line-height: 1.65;
      font-variant-numeric: tabular-nums; overflow-x: hidden;
    }
    a { color: inherit; }
    :focus-visible { outline: 2px solid #38bdf8; outline-offset: 3px; border-radius: 4px; }

    .bg { position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background:
        radial-gradient(ellipse 70% 50% at 15% 0%, rgba(14,165,233,.2), transparent 60%),
        radial-gradient(ellipse 60% 45% at 90% 15%, rgba(139,92,246,.18), transparent 60%),
        radial-gradient(ellipse 60% 40% at 50% 100%, rgba(56,189,248,.1), transparent 60%),
        linear-gradient(180deg, #060c18, #0a1428 55%, #060c18); }
    .bg::after { content: ''; position: absolute; inset: 0;
      background-image: linear-gradient(rgba(56,189,248,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(56,189,248,.05) 1px, transparent 1px);
      background-size: 56px 56px;
      -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 20%, #000 10%, transparent 75%);
      mask-image: radial-gradient(ellipse 90% 60% at 50% 20%, #000 10%, transparent 75%); }

    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

    /* Navigation */
    .nav { position: sticky; top: 0; z-index: 20; background: rgba(6,12,24,.78);
      -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(56,189,248,.1); }
    .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
    .brand { text-decoration: none; color: #fff; font-weight: 700; letter-spacing: .01em; }
    .nav ul { display: flex; align-items: center; gap: 22px; list-style: none; margin: 0; padding: 0; }
    .nav ul a { text-decoration: none; font-size: .92rem; color: #94a3b8; }
    .nav ul a:hover { color: #38bdf8; }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 26px;
      border-radius: 12px; font-weight: 600; font-size: 1rem; text-decoration: none; color: #fff; border: 1px solid transparent;
      transition: transform .2s, box-shadow .2s; }
    .btn:hover { transform: translateY(-2px); }
    .btn-wa { background: #1faa59; box-shadow: 0 8px 30px rgba(37,211,102,.28); }
    .btn-wa:hover { box-shadow: 0 10px 38px rgba(37,211,102,.45); }
    .btn-ghost { border-color: rgba(139,92,246,.5); background: rgba(139,92,246,.12); }
    .btn-ghost:hover { box-shadow: 0 8px 30px rgba(139,92,246,.35); }
    .btn-sm { padding: 9px 16px; font-size: .88rem; border-radius: 10px; }

    /* Hero */
    .hero { padding: 72px 0 64px; }
    .hero .wrap { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: center; }
    h1 { margin: 0 0 20px; font-size: clamp(2.2rem, 5.4vw, 4rem); line-height: 1.08; color: #fff; font-weight: 700;
      letter-spacing: -.02em; text-shadow: 0 0 40px rgba(56,189,248,.35); }
    h1 span { display: block; margin-top: 14px; font-size: clamp(1.1rem, 2.2vw, 1.5rem); font-weight: 500; letter-spacing: 0;
      color: #c4b5fd; text-shadow: 0 0 24px rgba(139,92,246,.45); }
    .lead { max-width: 56ch; font-size: 1.1rem; margin: 0 0 30px; }
    .lead strong { color: #fff; font-weight: 600; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 14px; }

    .counter { position: relative; padding: 30px; border-radius: 20px; background: rgba(13,21,38,.82);
      border: 1px solid rgba(56,189,248,.28); box-shadow: 0 0 0 1px rgba(139,92,246,.18), 0 20px 70px rgba(14,165,233,.22), inset 0 0 50px rgba(139,92,246,.08); }
    .status { display: flex; align-items: center; gap: 10px; margin: 0 0 22px; font-weight: 600; color: #e2e8f0; }
    .dot { width: 11px; height: 11px; border-radius: 50%; background: #64748b; flex: none; }
    .status.open .dot { background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,.6); animation: pulse 2s infinite; }
    .status.closed .dot { background: #f43f5e; }
    @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
    .counter address { font-style: normal; font-size: 1.65rem; line-height: 1.25; color: #fff; font-weight: 700; margin-bottom: 18px; }
    .counter address small { display: block; margin-top: 6px; font-size: 1rem; font-weight: 400; color: #94a3b8; }
    .counter p { margin: 0; font-size: .95rem; color: #94a3b8; }
    .counter p a { color: #38bdf8; font-weight: 600; text-decoration: none; }

    /* Services */
    .section-head { padding: 24px 0 8px; }
    h2 { margin: 0 0 12px; font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.2; color: #fff; letter-spacing: -.01em; }
    .section-head p { max-width: 62ch; margin: 0; }
    .group { display: grid; grid-template-columns: 1fr 1.25fr; gap: 40px; padding: 44px 0; position: relative; }
    .group::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, #38bdf8, #8b5cf6 55%, transparent); box-shadow: 0 0 14px rgba(56,189,248,.5); }
    .group h3 { margin: 0 0 12px; font-size: 1.3rem; line-height: 1.3; color: #fff; }
    .group p { margin: 0 0 18px; max-width: 46ch; }
    .prices { list-style: none; margin: 0; padding: 0; }
    .prices li { display: flex; align-items: baseline; gap: 12px; padding: 12px 0; }
    .prices .name { color: #e2e8f0; font-weight: 500; }
    .prices .fill { flex: 1; border-bottom: 2px dotted rgba(148,163,184,.3); transform: translateY(-4px); min-width: 16px; }
    .prices .cost { font-weight: 700; color: #38bdf8; white-space: nowrap; text-shadow: 0 0 18px rgba(56,189,248,.45); }
    .prices .cost small { font-weight: 400; color: #94a3b8; text-shadow: none; }
    .prices .ask { font-weight: 500; color: #a78bfa; white-space: nowrap; }

    /* Why us */
    .why { padding: 60px 0; }
    .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; margin-top: 32px; }
    .why-grid h3 { margin: 0 0 8px; font-size: 1.15rem; color: #fff; padding-left: 14px; border-left: 3px solid #8b5cf6; }
    .why-grid p { margin: 0; }

    /* Footer */
    footer { margin-top: 40px; padding: 56px 0 40px; border-top: 1px solid rgba(56,189,248,.14); background: rgba(6,12,24,.7); }
    .foot { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 40px; }
    footer h2 { font-size: 1.05rem; margin-bottom: 10px; }
    footer address { font-style: normal; }
    footer a { color: #38bdf8; text-decoration: none; }
    footer a:hover { text-decoration: underline; }
    footer ul { list-style: none; margin: 0; padding: 0; }
    footer li { margin-bottom: 6px; }
    .legal { margin-top: 36px; padding-top: 20px; border-top: 1px solid rgba(148,163,184,.14); font-size: .85rem; color: #64748b; }

    @media (max-width: 860px) {
      .hero { padding: 44px 0 40px; }
      .hero .wrap, .group, .why-grid, .foot { grid-template-columns: 1fr; }
      .hero .wrap { gap: 32px; } .group { gap: 20px; padding: 36px 0; } .why-grid { gap: 24px; }
      .nav ul li:not(:last-child) { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .status.open .dot { animation: none; }
      .btn { transition: none; }
    }
  </style>
</head>
<body>
  <div class="bg" aria-hidden="true"></div>

  <header class="nav">
    <div class="wrap">
      <a class="brand" href="/"><%= data.settings.shopName %></a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#services">Services and prices</a></li>
          <li><a href="#why-us">Why choose us</a></li>
          <li><a href="/shop">Laptop shop</a></li>
          <li><a class="btn btn-wa btn-sm" href="https://wa.me/254759697878" target="_blank" rel="noopener">WhatsApp us</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div>
          <h1>Cyber Services in Mwea / Wang'uru
            <span>Printing, laptop repair, software installation and online applications</span>
          </h1>
          <p class="lead">Expert Cyber Services is <strong>behind Lainisha Sacco in Wang'uru</strong>. Walk in for printing, photocopying, laptop repair, internet access and government online applications, or message us first on WhatsApp.</p>
          <div class="cta-row">
            <a class="btn btn-wa" href="https://wa.me/254759697878" target="_blank" rel="noopener">WhatsApp Us on +254 759 697878</a>
            <a class="btn btn-ghost" href="#services">See prices</a>
          </div>
        </div>
        <aside class="counter" aria-label="Shop location and opening hours">
          <p class="status" id="status" role="status"><span class="dot"></span><span id="status-text">Open Monday to Saturday, 7:30 am to 8:30 pm</span></p>
          <address>Behind Lainisha Sacco<small>Wang'uru, Mwea, Kenya</small></address>
          <p>Call <a href="tel:+254759697878">+254 759 697878</a> or just walk in. Closed on Sundays.</p>
        </aside>
      </div>
    </section>

    <section id="services" class="wrap">
      <div class="section-head">
        <h2>Cyber services and prices in Wang'uru, Mwea</h2>
        <p>Every price below is what you pay at our shop in Wang'uru. Ask on WhatsApp if your job is not listed.</p>
      </div>
      <% groups.forEach((g) => { %>
      <article id="<%= g.id %>" class="group">
        <div>
          <h3><%= g.title %></h3>
          <p><%= g.intro %></p>
          <a class="btn btn-ghost btn-sm" href="https://wa.me/254759697878?text=<%= encodeURIComponent('Hello Expert Cyber Services, I need help with: ' + g.title) %>" target="_blank" rel="noopener">Ask on WhatsApp</a>
        </div>
        <ul class="prices">
          <% g.items.forEach((i) => { %>
          <li>
            <span class="name"><%= i.name %></span>
            <span class="fill" aria-hidden="true"></span>
            <% if (i.price) { %>
              <span class="cost"><%= i.from ? 'From ' : '' %><%= fmt(i.price) %><% if (i.unit) { %><small><%= i.unit %></small><% } %></span>
            <% } else { %>
              <span class="ask">Ask for a price</span>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </article>
      <% }) %>
    </section>

    <section id="why-us" class="why">
      <div class="wrap">
        <h2>Why choose Expert Cyber Services in Wang'uru</h2>
        <div class="why-grid">
          <div>
            <h3>Fast service</h3>
            <p>Printing, photocopying and lamination happen at the counter while you wait. You do not travel to Kerugoya or Embu for a document or a repair.</p>
          </div>
          <div>
            <h3>Located in Wang'uru</h3>
            <p>We sit behind Lainisha Sacco, in the middle of Wang'uru town, with Mwea residents, students and farmers walking in daily.</p>
          </div>
          <div>
            <h3>Expert technicians</h3>
            <p>Our technicians repair laptops, install software and file government applications for you. Prices stay on this page, so you know the cost before you walk in.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="foot">
        <div>
          <h2><%= data.settings.shopName %></h2>
          <address>
            Behind Lainisha Sacco,<br />
            Wang'uru, Kenya
          </address>
          <p style="margin:14px 0 0"><a class="btn btn-wa btn-sm" href="https://wa.me/254759697878" target="_blank" rel="noopener">WhatsApp Us on +254 759 697878</a></p>
        </div>
        <div>
          <h2>Contact and hours</h2>
          <p style="margin:0 0 8px">Phone: <a href="tel:+254759697878">+254 759 697878</a></p>
          <p style="margin:0">Monday to Saturday: 7:30 am to 8:30 pm<br />Sunday: Closed</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/shop">Laptop and accessories shop</a></li>
            <li><a href="#printing">Printing in Wang'uru</a></li>
            <li><a href="#computer-repair">Laptop repair in Mwea</a></li>
            <li><a href="#government-services">Government online applications</a></li>
            <li><a href="#internet-training">Internet access and training</a></li>
          </ul>
        </div>
      </div>
      <p class="legal">Expert Cyber Services, cyber café and computer shop in Wang'uru, Mwea. All prices in Kenyan shillings (KES).</p>
    </div>
  </footer>

  <script>
    (function () {
      var el = document.getElementById('status');
      var txt = document.getElementById('status-text');
      if (!el || !txt || !window.Intl) return;
      try {
        var p = {};
        new Intl.DateTimeFormat('en-US', { timeZone: 'Africa/Nairobi', weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false })
          .formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var mins = (parseInt(p.hour, 10) % 24) * 60 + parseInt(p.minute, 10);
        var day = p.weekday;
        var open = day !== 'Sun' && mins >= 450 && mins < 1230;
        el.className = 'status ' + (open ? 'open' : 'closed');
        if (open) txt.textContent = 'Open now, closes at 8:30 pm';
        else if (day === 'Sun' || (day === 'Sat' && mins >= 1230)) txt.textContent = 'Closed now, opens Monday at 7:30 am';
        else if (mins < 450) txt.textContent = 'Closed now, opens today at 7:30 am';
        else txt.textContent = 'Closed now, opens tomorrow at 7:30 am';
      } catch (e) { /* keep static hours text */ }
    })();
  </script>
</body>
</html>
