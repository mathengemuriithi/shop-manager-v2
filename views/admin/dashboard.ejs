<%- include('../partials/layout-top', { title: 'Dashboard', data, username, messages }) %>

<!-- ── STAT CARDS ───────────────────────────────────────────────────────── -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

  <div class="stat-card rounded-xl p-5">
    <div class="flex items-start justify-between mb-3">
      <span class="text-2xl">📦</span>
      <span class="badge bg-blue-950 text-brand-400 px-2 py-0.5 rounded-md">STOCK</span>
    </div>
    <div class="text-3xl font-bold text-white mb-1"><%= stats.totalProducts %></div>
    <div class="text-xs text-slate-500">Products Listed</div>
  </div>

  <div class="stat-card rounded-xl p-5">
    <div class="flex items-start justify-between mb-3">
      <span class="text-2xl">🔧</span>
      <span class="badge bg-purple-950 text-purple-400 px-2 py-0.5 rounded-md">SVCS</span>
    </div>
    <div class="text-3xl font-bold text-white mb-1"><%= stats.totalServices %></div>
    <div class="text-xs text-slate-500">Services Offered</div>
  </div>

  <div class="stat-card rounded-xl p-5">
    <div class="flex items-start justify-between mb-3">
      <span class="text-2xl">🏷️</span>
      <span class="badge bg-green-950 text-green-400 px-2 py-0.5 rounded-md">CATS</span>
    </div>
    <div class="text-3xl font-bold text-white mb-1"><%= data.categories.length %></div>
    <div class="text-xs text-slate-500">Categories</div>
  </div>

  <div class="stat-card rounded-xl p-5">
    <div class="flex items-start justify-between mb-3">
      <span class="text-2xl">💰</span>
      <span class="badge bg-yellow-950 text-yellow-400 px-2 py-0.5 rounded-md">VALUE</span>
    </div>
    <div class="text-2xl font-bold text-white mb-1 font-mono">
      <%= data.settings.currencySymbol %> <%= stats.totalValue.toLocaleString() %>
    </div>
    <div class="text-xs text-slate-500">Est. Stock Value</div>
  </div>
</div>

<!-- ── TWO COLUMN LAYOUT ─────────────────────────────────────────────────── -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Recent Items Table -->
  <div class="lg:col-span-2 card card-glow rounded-xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b" style="border-color:rgba(56,189,248,0.08);">
      <h2 class="font-semibold text-white text-sm">Recent Items</h2>
      <a href="/admin/products" class="text-xs text-brand-400 hover:text-brand-300 transition-colors">View all →</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="border-bottom:1px solid rgba(56,189,248,0.06);">
            <th class="px-6 py-3 text-left text-xs text-slate-600 uppercase tracking-wide">Item</th>
            <th class="px-4 py-3 text-left text-xs text-slate-600 uppercase tracking-wide">Category</th>
            <th class="px-4 py-3 text-right text-xs text-slate-600 uppercase tracking-wide">Price</th>
            <th class="px-4 py-3 text-center text-xs text-slate-600 uppercase tracking-wide">Stock</th>
          </tr>
        </thead>
        <tbody>
          <% const recent = data.products.slice(-8).reverse(); %>
          <% recent.forEach(item => { %>
            <% const cat = data.categories.find(c => c.id === item.categoryId); %>
            <tr class="table-row border-b" style="border-color:rgba(56,189,248,0.04);">
              <td class="px-6 py-3">
                <div class="flex items-center gap-3">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" class="w-8 h-8 rounded-lg object-cover" style="border:1px solid rgba(56,189,248,0.15);" />
                  <% } else { %>
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-sm" style="background:rgba(56,189,248,0.06);border:1px solid rgba(56,189,248,0.1);">
                      <%= item.type === 'service' ? '🔧' : '📦' %>
                    </div>
                  <% } %>
                  <div>
                    <div class="text-white text-sm font-medium"><%= item.name %></div>
                    <div class="text-xs text-slate-600 font-mono"><%= item.sku || '—' %></div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-slate-400 text-xs"><%= cat ? cat.icon + ' ' + cat.name : '—' %></td>
              <td class="px-4 py-3 text-right font-mono text-brand-400 text-sm"><%= data.settings.currencySymbol %> <%= item.price.toLocaleString() %></td>
              <td class="px-4 py-3 text-center">
                <% if (item.type === 'service') { %>
                  <span class="badge bg-purple-950 text-purple-400 px-2 py-0.5 rounded-md">Service</span>
                <% } else if (item.stock === 0) { %>
                  <span class="badge bg-red-950 text-red-400 px-2 py-0.5 rounded-md">Out</span>
                <% } else if (item.stock <= 3) { %>
                  <span class="badge bg-yellow-950 text-yellow-400 px-2 py-0.5 rounded-md"><%= item.stock %> left</span>
                <% } else { %>
                  <span class="badge bg-green-950 text-green-400 px-2 py-0.5 rounded-md"><%= item.stock %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (recent.length === 0) { %>
            <tr><td colspan="4" class="px-6 py-8 text-center text-slate-600 text-sm">No items yet. <a href="/admin/products/add" class="text-brand-400">Add your first item →</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column -->
  <div class="space-y-5">

    <!-- Low Stock Alert -->
    <div class="card rounded-xl overflow-hidden">
      <div class="px-5 py-4 border-b" style="border-color:rgba(56,189,248,0.08);">
        <h2 class="font-semibold text-white text-sm">⚠️ Low Stock Alert</h2>
      </div>
      <div class="p-4 space-y-2">
        <% if (stats.lowStock.length === 0) { %>
          <p class="text-xs text-slate-600 text-center py-3">All stocked up! 🎉</p>
        <% } else { %>
          <% stats.lowStock.forEach(item => { %>
            <div class="flex items-center justify-between py-1.5">
              <span class="text-sm text-slate-300 truncate flex-1"><%= item.name %></span>
              <span class="badge bg-red-950 text-red-400 px-2 py-0.5 rounded-md ml-2"><%= item.stock %></span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Categories Overview -->
    <div class="card rounded-xl overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b" style="border-color:rgba(56,189,248,0.08);">
        <h2 class="font-semibold text-white text-sm">Categories</h2>
        <a href="/admin/categories" class="text-xs text-brand-400 hover:text-brand-300">Manage →</a>
      </div>
      <div class="p-4 space-y-2">
        <% data.categories.forEach(cat => { %>
          <% const count = data.products.filter(p => p.categoryId === cat.id).length; %>
          <div class="flex items-center justify-between py-1">
            <div class="flex items-center gap-2">
              <span><%= cat.icon %></span>
              <span class="text-sm text-slate-300"><%= cat.name %></span>
            </div>
            <span class="badge bg-slate-800 text-slate-400 px-2 py-0.5 rounded-md"><%= count %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card rounded-xl p-5">
      <h2 class="font-semibold text-white text-sm mb-4">Quick Actions</h2>
      <div class="space-y-2">
        <a href="/admin/products/add" class="btn-primary flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-white text-sm font-medium">
          ➕ Add New Item
        </a>
        <a href="/admin/categories" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm text-slate-300 hover:text-white transition-colors" style="background:rgba(56,189,248,0.06);border:1px solid rgba(56,189,248,0.1);">
          🏷️ Manage Categories
        </a>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/layout-bottom') %>
